    {"id":"B001","task_summary":"核對本次查得的合成商品庫存與已檢索的換貨條款，說明缺貨時能否換同系列商品；目前只需答覆。","scope_condition":"same","lesson_state":"eligible","version_relation":"same","features":{"tags":["live_fact","static_policy","evidence_available"],"evidence_state":"present","annotation_verified":true}},
